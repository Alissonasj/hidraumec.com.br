{
	"mcpServers": {
		"next-devtools": {
			"type": "local",
			"command": "npx",
			"args": [
				"-y",
				"next-devtools-mcp@latest"
			],
			"tools": [
				"*"
			]
		},
		"shadcn": {
			"type": "local",
			"command": "npx",
			"args": [
				"shadcn@latest",
				"mcp"
			],
			"tools": [
				"*"
			]
		}
	}
}
